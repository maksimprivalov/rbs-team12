DATABASE_URL=sqlite:///./oblak.db
SECRET_KEY=change-this-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_BYTES=10485760

# Firecracker microVM izvršavanje (samo Linux + KVM; dev: artefakti u oblak/fc-assets/)
FIRECRACKER_ENABLED=true
FIRECRACKER_BIN=firecracker
# Folder sa vmlinux i rootfs.ext4 (default: oblak/fc-assets). Otkomentariši da promeniš:
# FIRECRACKER_ASSETS=./fc-assets
FIRECRACKER_VCPU=1
FIRECRACKER_MEM_MIB=256
FIRECRACKER_EXEC_TIMEOUT=30
